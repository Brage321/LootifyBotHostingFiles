# Yapper (Yapin') Bot Token
# Get it from: Settings → Developer → your bot → Token tab
# NEVER share this token or commit it to git
YAPPER_TOKEN=your_bot_token_here
# Optional. Bot hosts can provide this automatically; local runs use the SDK default.
# YAPPER_API_URL=https://your-api-host/api/bot/v1

# Optional: channel ID where update embeds are posted (defaults to the support channel)
# UPDATE_CHANNEL_ID=2371da9a-c956-48bd-98bc-a2e85cc5371d
# Optional: support server ID
# SUPPORT_SERVER_ID=7f3ee36e-c0a5-44d5-97ae-a8ea85558828
# Optional: GitHub repo to watch for updates (owner/repo)
# GITHUB_REPO=Brage321/LootifyBotHostingFiles
# Optional: GitHub token for higher API rate limits
# GITHUB_TOKEN=your_github_token_here
